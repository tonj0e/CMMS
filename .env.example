# Copy to .env and fill in. .env is gitignored.

# MySQL / TiDB connection string. For managed hosts append ?ssl={"rejectUnauthorized":true}
# (or omit it: non-local hosts get TLS automatically).
DATABASE_URL=mysql://root:password@localhost:3306/ccms

# Session signing secret, at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=

# Server port
PORT=3000

# Development only: enables the one-click demo logins. Leave unset in production.
DEV_AUTH_ENABLED=true

# Secret code a new staff member must enter to create their own staff account. Leave empty to switch staff sign-up off.
# Pick something long and share it only with staff: openssl rand -hex 6
STAFF_ACCESS_CODE=

# Optional: openId that is promoted to admin automatically
OWNER_OPEN_ID=

# Optional Manus OAuth / storage (not needed for email + password login)
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
UPLOAD_DIR=uploads

# Copy to .env and fill in. .env is gitignored.

# MySQL / TiDB connection string. For managed hosts append ?ssl={"rejectUnauthorized":true}
# (or omit it: non-local hosts get TLS automatically).
DATABASE_URL=mysql://root:password@localhost:3306/ccms

# Session signing secret, at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=

# Server port
PORT=3000

# Optional: openId that is promoted to admin automatically
OWNER_OPEN_ID=

# Where complaint attachments are stored on disk
UPLOAD_DIR=uploads
